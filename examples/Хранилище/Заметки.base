filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("Шаблоны")'
formulas:
  importance: 'if(priority, priority * 10, 0)'
properties:
  status:
    displayName: Статус
  formula.importance:
    displayName: Приоритет
views:
  - type: table
    name: Все заметки
    order: [file.name, file.folder, status, tags, formula.importance]
  - type: cards
    name: Карточки
    order: [file.name, status, tags]
  - type: kanban
    name: Доска
    groupBy:
      property: note.status
    groupOrder: [Запланировано, В работе, Готово, null]
    order: [file.name, tags]
